# Pizza Monitor Configuration
PIZZA_API_URL=https://www.pizzint.watch/api/dashboard-data
POLL_INTERVAL_MINUTES=5

# Signal Detection Thresholds
DEFCON_THRESHOLD=3
SPIKE_THRESHOLD=2
CONFIDENCE_THRESHOLD=0.7

# Polymarket Configuration
POLYMARKET_API_URL=https://api.polymarket.com
# WALLET_ADDRESS=your_wallet_address_here
# PRIVATE_KEY=your_private_key_here  # ONLY for live trading - NEVER commit this

# Trading Mode
SIMULATION_MODE=true

# Risk Management
MAX_BET_SIZE_USD=100.0
MAX_DAILY_EXPOSURE=500.0
MAX_POSITIONS=5
PORTFOLIO_VALUE=1000.0

# Email Notifications (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# EMAIL_TO=alerts@example.com

# Telegram Notifications (optional)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# Database
DATABASE_URL=sqlite:///data/pizza_bot.db

# Logging
LOG_LEVEL=INFO
